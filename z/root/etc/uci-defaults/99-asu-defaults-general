#!/bin/sh
#===============================================================================
# setup-phicomm-production.sh — Phicomm K2 DSA production defaults
#-------------------------------------------------------------------------------
# - DSA only: lan1..lan4 + wan netdevs
# - MAC scheme:
#     LAN = factory 0x28   -> applied to br-lan bridge
#     WAN = factory 0x2e   -> applied to wan port
# - Network is rebuilt from scratch (deterministic, idempotent).
# - Run manually, then reboot.
#===============================================================================

. /lib/functions/system.sh

# --- Guard: DSA port netdevs must exist ---------------------------------------
for p in lan1 lan2 lan3 lan4 wan; do
    if [ ! -e "/sys/class/net/$p" ]; then
        echo "ERROR: DSA netdev '$p' not found." >&2
        echo "ERROR: This script must only run on the DSA build of Phicomm K2." >&2
        exit 1
    fi
done

# --- Vendor MAC scheme ---------------------------------------------------------
FACTORY_MTD=$(find_mtd_part factory)
if [ -z "$FACTORY_MTD" ]; then
    echo "ERROR: factory partition not found." >&2
    exit 1
fi

LAN_MAC=$(get_mac_binary "$FACTORY_MTD" 0x28)
WAN_MAC=$(get_mac_binary "$FACTORY_MTD" 0x2e)

if [ -z "$LAN_MAC" ] || [ -z "$WAN_MAC" ]; then
    echo "ERROR: could not read MAC addresses from factory partition." >&2
    exit 1
fi

echo "LAN_MAC=$LAN_MAC"
echo "WAN_MAC=$WAN_MAC"

NEW_ULA=$(printf "fd%02x:%04x:%04x::/48" $((RANDOM%256)) $((RANDOM%65536)) $((RANDOM%65536)))

# --- DHCP / dnsmasq cleanup ----------------------------------------------------
uci -q del dhcp.wan
uci -q del dhcp.lan.ra
uci -q del dhcp.lan.ra_slaac
uci -q del dhcp.lan.ra_flags
uci set dhcp.lan.ignore='1'
uci -q del network.lan.ip6assign
uci -q del dhcp.lan.dhcpv6
uci -q del dhcp.odhcpd

uci set dhcp.@dnsmasq[0].noresolv='1'
uci -q delete dhcp.@dnsmasq[0].server
uci add_list dhcp.@dnsmasq[0].server='8.8.8.8'
uci add_list dhcp.@dnsmasq[0].server='1.1.1.1'

uci commit system
uci commit dhcp

# --- Disable services not needed ----------------------------------------------
for i in firewall mwan3 odhcpd; do
    if [ -x "/etc/init.d/$i" ] && /etc/init.d/"$i" enabled; then
        /etc/init.d/"$i" disable
        /etc/init.d/"$i" stop
    fi
done

service odhcpd disable 2>/dev/null
service log disable 2>/dev/null
service firewall disable 2>/dev/null

# --- Remove old network sections ----------------------------------------------
uci -q delete network.wan
uci -q delete network.wan6
uci -q delete network.lan
uci -q delete network.br-lan
uci -q delete network.br-wan
uci -q delete network.switch0
uci -q delete network.switch_vlan

for i in $(uci show network 2>/dev/null | grep switch_vlan | cut -d'.' -f2 | cut -d'=' -f1); do
    uci -q delete network.$i
done
while uci -q delete network.@switch_vlan[0]; do :; done
while uci -q delete network.@device[0]; do :; done

# --- 1. Network Configuration -------------------------------------------------

# WAN port device
uci set network.wan_dev='device'
uci set network.wan_dev.name='wan'
uci set network.wan_dev.macaddr="$WAN_MAC"

# LAN bridge with LAN MAC
uci set network.lan_br='device'
uci set network.lan_br.name='br-lan'
uci set network.lan_br.type='bridge'
uci set network.lan_br.macaddr="$LAN_MAC"
uci add_list network.lan_br.ports='lan1'
uci add_list network.lan_br.ports='lan2'
uci add_list network.lan_br.ports='lan3'
uci add_list network.lan_br.ports='lan4'
uci set network.lan_br.vlan_filtering='0'

if ! uci -q get network.globals > /dev/null; then
    uci set network.globals='globals'
fi
uci set network.globals.ula_prefix="$NEW_ULA"
uci set network.globals.packet_steering='1'

# LAN interface
uci set network.lan='interface'
uci set network.lan.device='br-lan'
uci set network.lan.proto='static'
uci set network.lan.ipaddr='192.168.1.1/24'
uci set network.lan.delegate='0'

# WAN interface
uci set network.wan='interface'
uci set network.wan.proto='none'
uci set network.wan.device='wan'

# --- 2. DHCP finalization ------------------------------------------------------
uci set dhcp.lan.ignore='1'
uci -q del dhcp.wan
uci -q del dhcp.lan.ra
uci -q del dhcp.lan.ra_slaac
uci -q del dhcp.lan.ra_flags
uci -q del dhcp.odhcpd

uci commit network

/etc/init.d/log start 2>/dev/null

# --- 3. Wireless Configuration -------------------------------------------------
for j in $(seq 0 4); do uci -q delete wireless.@wifi-iface[0]; done

# Detect radio bands and rename accordingly
case $(uci -q get wireless.radio0.band) in
  '5g') uci rename wireless.radio0='5G';;
  '2g') uci rename wireless.radio0='2G';;
esac
case $(uci -q get wireless.radio1.band) in
  '5g') uci rename wireless.radio1='5G';;
  '2g') uci rename wireless.radio1='2G';;
esac

# 5G radio
uci -q del wireless.5G.disabled
uci set wireless.5G.beacon_int='200'
uci set wireless.5G.country='US'
uci set wireless.5G.htmode='HT20'
uci set wireless.5G.channel='36'
uci set wireless.5G.txpower='28'
uci set wireless.5G.cell_density='0'

# 5G AP
uci set wireless.wifinet0='wifi-iface'
uci set wireless.wifinet0.device='5G'
uci set wireless.wifinet0.mode='ap'
uci set wireless.wifinet0.encryption='none'
uci set wireless.wifinet0.ssid='Phicomm-K2 - 5G'
uci set wireless.wifinet0.disassoc_low_ack='0'
uci set wireless.wifinet0.network='lan'
uci set wireless.wifinet0.isolate='1'
uci set wireless.wifinet0.wds='1'

# 2G radio
uci -q del wireless.2G.disabled
uci set wireless.2G.beacon_int='200'
uci set wireless.2G.noscan='1'
uci set wireless.2G.country='US'
uci set wireless.2G.htmode='HT20'
uci set wireless.2G.channel='1'
uci set wireless.2G.cell_density='0'
uci set wireless.2G.txpower='27'

# 2G AP
uci set wireless.wifinet1='wifi-iface'
uci set wireless.wifinet1.device='2G'
uci set wireless.wifinet1.mode='ap'
uci set wireless.wifinet1.ssid='Phicomm-K2'
uci set wireless.wifinet1.encryption='none'
uci set wireless.wifinet1.disassoc_low_ack='0'
uci set wireless.wifinet1.network='lan'
uci set wireless.wifinet1.isolate='1'
uci set wireless.wifinet1.wds='1'

# --- 4. System & Hostname ------------------------------------------------------
uci set system.@system[0].hostname='Phicomm-K2'
uci set system.@system[0].notes='Haddad Inc - Developed by Eng. Salah'
uci set system.@system[0].zonename='Asia/Aden'
uci set system.@system[0].timezone='<+03>-3'
uci set system.@system[0].log_proto='udp'
uci set system.@system[0].conloglevel='8'
uci set system.@system[0].cronloglevel='5'

uci -q del system.ntp.enabled
uci -q del system.ntp.enable_server

# --- 5. Firewall & Security ----------------------------------------------------
if [ -f /etc/config/firewall ]; then
    mv /etc/config/firewall /etc/config/firewall.unused
fi

passwd -d root

uci set dropbear.@dropbear[0].PasswordAuth='0'
uci set dropbear.@dropbear[0].RootPasswordAuth='0'

# --- 6. Customization & Branding -----------------------------------------------
if [ -f /www/luci-static/resources/view/status/include/10_system.js ]; then
    sed -i "s/boardinfo\.model/'Phicomm K2 v22.4-DSA - Developed by HADDAD-INC'/g" /www/luci-static/resources/view/status/include/10_system.js
fi

if [ -f /etc/openwrt_release ]; then
    sed -i "s/DISTRIB_DESCRIPTION=.*/DISTRIB_DESCRIPTION='Haddad-Inc @'/g" /etc/openwrt_release
fi

if [ -f /etc/os-release ]; then
    sed -i "s/PRETTY_NAME=.*/PRETTY_NAME='Haddad-Inc @ '/g" /etc/os-release
fi

FOOTER="/usr/share/ucode/luci/template/themes/bootstrap/footer.ut"
if [ -f "$FOOTER" ]; then
    sed -i '/{% endif %}/a \                <span style="margin-left:8px;color:var(--primary);"> ✦ <a href="https:\/\/www.facebook.com\/eng.salah.alhaddad\/" target="_blank" rel="noreferrer" style="color:var(--primary);text-decoration:none;font-weight:bold;">Modified by Eng Salah / Haddad-Inc</a></span>' "$FOOTER"
fi

# --- Final commit --------------------------------------------------------------
uci commit

echo "All done! Phicomm K2 DSA settings applied."
exit 0